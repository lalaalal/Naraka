{
  "schemaVersion": 1,
  "id": "naraka",
  "version": "${version}",
  "name": "Naraka",
  "description": "${description}",
  "authors": "${mod_author}",
  "contact": {
    "homepage": "https://github.com/lalaalal/Naraka"
  },
  "license": "MIT License",
  "icon": "naraka.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.yummy.naraka.fabric.NarakaModFabric"
    ],
    "fabric-datagen": [
      "com.yummy.naraka.fabric.data.NarakaDataGenerator"
    ],
    "client": [
      "com.yummy.naraka.fabric.client.NarakaModFabricClient"
    ],
    "jade": [
      "com.yummy.naraka.jade.NarakaJadePlugin"
    ]
  },
  "accessWidener": "naraka.fabric.accesswidener",
  "mixins": [
    "naraka.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=${fabric_version}"
  }
}
